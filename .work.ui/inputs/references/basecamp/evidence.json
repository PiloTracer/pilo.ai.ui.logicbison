    "headings": [
      {
        "tag": "h1",
        "text": "Manage projects, coordinate teams, and master your company with Basecamp."
      },
      {
        "tag": "h2",
        "text": "Famously straightforward and easy\u2011to\u2011use, there\u2019s simply nothing else like it."
      },
      {
        "tag": "h2",
        "text": "Take a minute to meet some of our customers"
      },
      {
        "tag": "h2",
        "text": "We asked our customers: \u201cWhat changed for the better since you switched to Basecamp?\u201d"
      },
      {
        "tag": "h2",
        "text": "How about a quick demonstration?"
      },
      {
        "tag": "h2",
        "text": "Big numbers. Highly-trusted. Rugged, reliable, ready."
      },
      {
        "tag": "h2",
        "text": "Remember when companies cared about service?"
      },
      {
        "tag": "h3",
        "text": "Durable infrastructure"
      },
      {
        "tag": "h3",
        "text": "Dependable customer service"
      },
      {
        "tag": "h2",
        "text": "Want to see a live demo and ask some questions first?"
      },
      {
        "tag": "h2",
        "text": "Have a great day!"
      }
    ],
