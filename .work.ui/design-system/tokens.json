{
  "color": {
    "text": {
      "primary": { "$type": "color", "$value": "oklch(24% 0.021 251.7)" },
      "secondary": { "$type": "color", "$value": "oklch(46% 0.020 251.0)" },
      "inverse": { "$type": "color", "$value": "oklch(100% 0 0)" }
    },
    "accent": { "$type": "color", "$value": "oklch(53.1% 0.091 194.8)" },
    "accentStrong": { "$type": "color", "$value": "oklch(43.4% 0.074 196.1)" },
    "accentText": { "$type": "color", "$value": "oklch(100% 0 0)" },
    "border": { "$type": "color", "$value": "oklch(87.9% 0.010 93.6)" }
  },
  "surface": {
    "base": { "$type": "color", "$value": "oklch(97.5% 0.008 98.9)" },
    "elevated": { "$type": "color", "$value": "oklch(100% 0 0)" },
    "inset": { "$type": "color", "$value": "oklch(94.5% 0.006 98.9)" },
    "overlay": { "$type": "color", "$value": "oklch(100% 0 0 / 0.90)" },
    "page": { "$type": "color", "$value": "{surface.base}" }
  },
  "fontFamily": {
    "display": { "$type": "fontFamily", "$value": "Fraunces, Georgia, serif" },
    "body": { "$type": "fontFamily", "$value": "Instrument Sans, system-ui, sans-serif" },
    "mono": { "$type": "fontFamily", "$value": "IBM Plex Mono, ui-monospace, monospace" }
  },
  "fontSize": {
    "100": { "$type": "fontSize", "$value": "0.875rem" },
    "200": { "$type": "fontSize", "$value": "1.0625rem" },
    "300": { "$type": "fontSize", "$value": "1.25rem" },
    "400": { "$type": "fontSize", "$value": "1.75rem" },
    "500": { "$type": "fontSize", "$value": "clamp(2.4rem, 5vw, 4.5rem)" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "24": { "$type": "dimension", "$value": "96px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "100ms" },
      "fast": { "$type": "duration", "$value": "160ms" },
      "normal": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "300ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
      "enter": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        { "color": "#1018280f", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#1018281a", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }
      ]
    },
    "inset": {
      "$type": "shadow",
      "$value": [ { "color": "#10182814", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "inset": true } ]
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "{fontSize.200}", "lineHeight": 1.5, "fontWeight": 400 }
    },
    "display": {
      "$type": "typography",
      "$value": { "fontFamily": "{fontFamily.display}", "fontSize": "{fontSize.500}", "lineHeight": 1.05, "fontWeight": 600 }
    }
  }
}
